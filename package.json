{
  "name": "insta360-web-editor",
  "version": "1.0.0",
  "description": "Professional 360 photo web editor with GPU optical stitching for Insta360 ONE R, X, X2, X3, X4, interactive 3D reframe, nadir tripod remover, and Model Context Protocol (MCP) AI bridge.",
  "author": "eltopouy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eltopouy/insta360-web-editor.git"
  },
  "keywords": [
    "insta360",
    "one-r",
    "360-photo",
    "photo-sphere",
    "threejs",
    "equirectangular",
    "dual-fisheye",
    "stitching",
    "mcp",
    "model-context-protocol"
  ],
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test src/utils/*.test.ts",
    "mcp": "node mcp/server.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.64.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  },
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "postcss-selector-parser": "^7.1.6"
  }
}
